# All files should use 2 spaces for indentation, UTF-8 encoding, and LF line endings.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.md]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2

[*.yml]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2

[Makefile]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
